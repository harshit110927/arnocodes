PORT=5000
ENVIRONMENT=development

# Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AI limits
AI_CHATBOT_MAX_PER_HOUR=3
AI_CODE_HELPER_MAX_PER_DAY=5
AI_GLOBAL_MAX_PER_DAY=300

# Token controls
AI_CHATBOT_MAX_OUTPUT_TOKENS=180
AI_CODE_HELPER_MAX_OUTPUT_TOKENS=900
AI_REQUEST_TIMEOUT_SECONDS=20
